ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=matt-abrams/mars-polar-fan-masks-1-rfdetr-seg-small-t1
ROBOFLOW_MODEL_TRAINING=0
# Optional meeting fallback after scripts/record_inference.py has saved live results.
ROBOFLOW_REPLAY=0
PORT=4173
HOST=127.0.0.1
# For a shared deployment, set both values and keep the access code private.
DEMO_ACCESS_CODE=
DEMO_DAILY_LIMIT=0

# Optional Jev-Omni review experiment. The private model service runs separately.
REVIEW_AGENT_ENABLED=0
REVIEW_AGENT_DAILY_CALL_LIMIT=0
JEV_SERVICE_URL=
JEV_SERVICE_TOKEN=
JEV_BACKEND=cuda-bf16
JEV_IMAGE_TOKENS=70
JEV_MIN_PROBABILITY=0.8
JEV_MIN_MARGIN=0.25
# Optional active-inference estimate; this omits idle GPU hosting.
JEV_COMPUTE_USD_PER_HOUR=
