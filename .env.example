ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=matt-abrams/mars-polar-fan-masks-1-rfdetr-seg-small-t1
ROBOFLOW_MODEL_TRAINING=0
# Optional meeting fallback after scripts/record_inference.py has saved live results.
ROBOFLOW_REPLAY=0
PORT=4173
HOST=127.0.0.1
# For a shared deployment, set both values and keep the access code private.
DEMO_ACCESS_CODE=
DEMO_DAILY_LIMIT=0
# Native-source pipeline. Keep this directory on persistent storage.
SCOUT_DATA_DIR=.scout
SCOUT_SOURCE_QUOTA_MIB=2048
# Optional: exact JP2 matching public/sources/orbit.json.
# SCOUT_ORBIT_PATH=/path/to/ESP_082142_0935_RED.JP2
# Full-observation reads need Python + NumPy + Pillow + opj_decompress on PATH.
SCOUT_PYTHON=python3
# Independent rollout switches; the experimental fringe remains opt-in in the UI.
SCOUT_NATIVE_REFINEMENT=1
SCOUT_TILED_DETECTION=1
SCOUT_EXPERIMENTAL_FRINGE=1
