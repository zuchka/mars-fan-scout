{
  "name": "mars-weather",
  "version": "1.0.0",
  "description": "Roboflow Mars fan evidence viewer and bounded human-reviewed vision-agent experiment.",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "npm run build --silent && node server.mjs",
    "test": "npm run build --silent && npm run typecheck --silent && node --test scripts/*.test.mjs",
    "prepare:agent-review": "npm run build --silent && node scripts/prepare_agent_review.mjs",
    "report:agent-review": "npm run build --silent && node scripts/report_agent_review.mjs",
    "purge:agent-review": "npm run build --silent && node scripts/purge_review_sessions.mjs",
    "prepare:boundary-review": "npm run build --silent && node scripts/prepare_boundary_review.mjs",
    "score:boundaries": "npm run build --silent && node scripts/score_boundaries.mjs",
    "validate:benchmark": "npm run build --silent && node scripts/validate_boundary_benchmark.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zuchka/mars-fan-scout.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/zuchka/mars-fan-scout/issues"
  },
  "homepage": "https://github.com/zuchka/mars-fan-scout#readme",
  "dependencies": {
    "fflate": "0.8.3",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
